  "decisions": [
    {
      "id": "dec-rlt-standort-tr-c1",
      "projectId": "proj-campus-nord",
      "title": "RLT-Standort: TR-B2 → TR-C1",
      "summary": "Die zentrale Raumlufttechnische Anlage soll statt in Technikraum TR-B2 in Technikraum TR-C1 (Untergeschoss, Ostflügel) installiert werden.",
      "previousState": "Installationsort TR-B2 (UG, Westtrakt)",
      "newState": "Installationsort TR-C1 (UG, Ostflügel)",
      "rationale": "Nachträglich eingebaute Server-Nische und zusätzliche Brandschutztüren begrenzen den nutzbaren Raum in TR-B2. Die vorgesehene Anlage inkl. Wartungsflächen passt dort nicht ausreichend hinein. Ein kleineres Gerät wäre für die vorgesehene Luftmenge (ca. 18.000 m³/h) ungeeignet. TR-C1 bietet mehr Aufstellfläche; die längere Kanalführung wird bewusst in Kauf genommen und nachgezogen.",
      "meetingDate": "2026-03-12",
      "reliability": "belegt",
      "resolutionStatus": "im_meeting_beschlossen",
      "approvalStatus": "offen",
      "affectedTeamIds": ["bauleitung", "elektrotechnik", "einkauf"],
      "sourceRefs": [
        {
          "sourceId": "src-meeting-kw11",
          "filename": "meeting-kw11-lueftung.md",
          "section": "§ TOP 3 – Beschluss Standortverlegung",
          "excerpt": "Die zentrale RLT-Anlage wird statt in Technikraum TR-B2 in Technikraum TR-C1 (Untergeschoss, Ostflügel) installiert."
        },
        {
          "sourceId": "src-meeting-kw11",
          "filename": "meeting-kw11-lueftung.md",
          "section": "§ TOP 1 – Rückblick und Aufmaß TR-B2",
          "excerpt": "Server-Nische und Brandschutztüren begrenzen den nutzbaren Raum; Gerät inkl. Wartungsflächen passt nicht ausreichend."
        }
      ],
      "supersedesIds": [
        "assume-location-tr-b2",
        "assume-electro-ss-ug-03-to-tr-b2"
      ],
